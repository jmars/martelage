]

# what the revocation entry says when a CRL WAS supplied: exactly what was
# checked, against which CRL, and what a supplied CRL cannot establish
REV_ARMED_UNCHECKABLE = ("checked against the revocation material THIS RUN WAS GIVEN and nothing else: %s. "
                         "No network path exists in this tool — nothing is fetched, no CRL is downloaded, no OCSP "
