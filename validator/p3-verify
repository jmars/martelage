#!/usr/bin/env python3
"""p3-verify — the MARTELAGE-0.1 verifier for the P3 anchor profile.

  profile wire string: p3-eidas-qualified-seal-asic-e   (spec §9.3)

This is a SECOND implementation, not a replacement: validator/martelage-verify
keeps its zero-dependency property (POSIX shell + the §10.1 tool list) and is
unchanged by this file. p3-verify needs a signature verifier and trust anchors,
which the base tier does not and must not have (§9.1b, §10.1). It therefore runs
under python3 and shells out to the `openssl` binary for every cryptographic
operation: python's standard library has no CMS or X.509 implementation, and
`openssl cms` / `openssl ts` / `openssl x509` are the ones this host has.

What it verifies (§9.3 P3):
  * the container is an ASiC-E: a ZIP with a correct `mimetype`, an ASiC
    manifest under META-INF/, and a CAdES signature entry, and no entry name
    twice — a duplicate name makes the content depend on which reader opens it;
  * every entry the ASiC manifest lists is present with the digest it states,
    every covered path stays inside the package (no absolute path, no '..', no
    symlink out), and no entry sits outside the manifest's coverage while
    claiming to be evidence;
  * the CAdES signature over META-INF/manifest.xml verifies, and EVERY signer
    of EVERY signature entry chains to a supplied trust anchor — the signer set
    is enumerated and held against the signerInfo count, so a co-signer cannot
    go unchecked. The construction is checked FIRST: this verifier implements
    the detached manifest-signature form only, so a CMS whose content is
    EMBEDDED (`openssl cms -sign ... -nodetach`) is refused by name before any
    chain or content question is asked, rather than being reported as a
    detached signature it is not;
  * no signer is a CA: a certificate with basicConstraints CA:TRUE is refused as
    a sealing party;
  * the digests the seal covers are the digests of the package files as they
    are on disk — a cryptographically valid seal over files that have moved is
    the failure P3 exists to catch;
  * an RFC 3161 token, if present, verifies against the anchors over one of the
    signature values, and the time it establishes is the time EVERY certificate
    date is checked against: every signer, every certificate in the chain each
    signer reaches, and the timestamping authority's own chain;
  * NO signer is the operator — every signer of every entry is compared against
    --operator-cert, and one of them being the operator refuses the container
    (§9.3 limit i);
  * revocation, ONLY from the CRLs the verifier was handed with --revocation:
    the signature, window and entry list of every supplied CRL are read, and
    every certificate in the chain a supplied CRL speaks for is checked against
    it. A certificate a supplied CRL lists as revoked refuses the container.
    There is no network path in this tool: nothing is fetched, downloaded or
    queried, and an OCSP responder is never contacted. CRL only — OCSP is not
    implemented here at all, not even from a supplied OCSP response.

What it does NOT verify, on any run, and says so in its own output (§10.7):
revocation unless --revocation is given — and then only against those CRLs, so
no live OCSP responder, no CRL download and no long-term validation; long-term
validation (LTV material is reported present or absent, never validated); the
truth or completeness of the records (§9.3 limit iii); the signer's legal
identity beyond what the certificate claims; and the signer's key usage beyond
the CA bit (this standard defines no key-usage profile for a seal).

exit: 0 CONFORMANT | 1 NON-CONFORMANT | 2 USAGE/UNREADABLE | 3 CANNOT DECIDE
"""

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import zipfile
import xml.etree.ElementTree as ET

PROG = "p3-verify"
PROFILE = "p3-eidas-qualified-seal-asic-e"
MIMETYPE = "application/vnd.etsi.asic-e+zip"
ASIC_MANIFEST = "META-INF/manifest.xml"
ASIC_TIMESTAMP = "META-INF/timestamp.tst"

# §3.3, printed verbatim by every run that names a package — the same two
# sentences, word for word, as validator/martelage-verify prints them.
RESID1 = ("  A package proves that what it contains was not altered after it left; it cannot prove that what it "
          "contains is all there was, and against an operator who rewrote everything before the first anchor it "
          "proves nothing.")
RESID2 = ("  A coherent tamper performed before the first observation is invisible to every mechanism in this "
          "standard.")

# §10.7, plus the three limits that travel with P3 (§9.3). Printed on every run,
# under its own heading, because a check this verifier cannot perform must never
# read as one it performed. The revocation entry is the one that changes with
# the input: unarmed it says no CRL is read at all (and it is byte-identical to
# what every earlier run printed), armed it says exactly what was checked and
# against which CRL, and what is still out of reach.
NOT_CHECKABLE = [
    ("revocation", "no CRL is read and no OCSP responder is contacted, by this verifier or by any run of it: there "
                   "is no network path in this tool at all. A chain established here is established by signature "
                   "and by certificate date only. 'Valid at the claimed time' below means the dates, never "
                   "revocation status."),
    ("long-term validation", "LTV material is reported present or absent and is never validated. A container "
                             "carrying archival timestamps or validation material is reported as carrying it, "
