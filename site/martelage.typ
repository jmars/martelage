#heading(level: 2)[#text("What an evidence package is")]
#block(width: measure, above: 0pt, below: 0.9em)[#text("An evidence package is a ")#strong[#text("directory")]#text(", not an archive (§4.1 MA-16). It holds:")]
#block(width: measure, above: 0pt, below: 0.9em)[#list([#strong[#text("Record stream files.")]#text(" JSON Lines files whose records are hash-chained within a stream: each record carries ")#ic("seq")#text(", which runs 1..n with no gaps, and ")#ic("prev")#text(", the ")#ic("body_sha")#text(" of the record before it (§6, §7.1–7.2). Two writers' records are never merged into one stream (§6.6).")], [#strong[#text("One manifest")]#text(", ")#ic("package.json")#text(", listing every other file in the package with its ")#ic("sha256")#text(" and its byte length, and stating three things beyond that file list:")#block(above: 0.3em)[#list([#text("the package's ")#strong[#text("scope")]#text(" — what it contains and, separately, what it does ")#emph[#text("not")]#text(", each absence carrying a meaning word from a fixed vocabulary (§8, MA-54 to MA-60);")], [#text("its ")#strong[#text("place in a package chain")]#text(" — ")#ic("prev.package_sha")#text(" and ")#ic("prev.how")#text(", saying whether a predecessor exists and where that value came from (§7.4);")], [#text("its ")#strong[#text("anchor statement")]#text(" — whether a party other than the producer holds this package's digest, and under which named profile (§9). The slot has named profiles at this version, and one of them is an eIDAS qualified seal — ")#link(<anchors>)[#text("the anchor profiles")]#text(" (usage.html#anchors)")#text(" (§9.3).")], indent: 1.2em, spacing: 0.4em)]#text("")], indent: 1.2em, spacing: 0.5em)]
#block(width: measure, above: 0pt, below: 0.9em)[#text("The ")#strong[#text("package digest")]#text(" is ")#ic("sha256")#text(" over the exact bytes of the manifest. The manifest carries no digest of itself; because it lists every other file's digest, that one value transitively pins every file in the package, including the scope statement and the anchor claim (§7.3.1 MA-47).")]
#block(width: measure, above: 0pt, below: 0.9em)[#text("All of it is checkable offline, with a POSIX shell and ")#ic("sha256sum")#text(", by someone who has never seen the producer: ")#link(<zero-tooling>)[#text("the zero-tooling check on the usage page")]#text(" (usage.html#zero-tooling)")#text(" is a normative property of the format, not an example (§4.6 MA-21).")]
