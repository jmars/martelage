  table.header([#strong[#text("code")]], [#strong[#text("meaning")]]), [#ic("0")], [#strong[#text("CONFORMANT")]#text(" — every check the run could perform passed. An unanchored package exits 0; the NOT-ANCHORED line has been printed.")], [#ic("1")], [#strong[#text("NON-CONFORMANT")]#text(" — a check failed: a digest, a length, a gap, a broken predecessor link, a torn line, a manifest count, an unknown scope word, an unsupported version, a chain break against ")#ic("--prev-package")#text(", a claimed anchor that is malformed or that the evidence contradicts.")], [#ic("2")], [#strong[#text("USAGE OR UNREADABLE")]#text(" — the invocation is wrong, or an input could not be read (an unreadable file is not an absence).")], [#ic("3")], [#strong[#text("CANNOT DECIDE")]#text(" — an input the validator needs to decide is absent: anchor evidence for a claimed anchor, trust anchors for P3, or a profile-specific verifier this validator is not. The validator MUST name the missing input.")])]
#block(width: measure, above: 0pt, below: 0.9em)[#strong[#text("Why code 3 exists.")]#text(" An instrument that cannot return \"undecided\" returns something else instead. A claimed anchor that cannot be checked is neither conformant nor refuted, and reporting it as either would be a false statement; it is not conformant enough to pass, so 3 is non-zero (§10.3). This is not a nicety — it is the same discipline as the residual: the format says what it could not establish.")]
